{
  "name": "stellar-shade-cli",
  "version": "0.1.1",
  "type": "module",
  "description": "Shade CLI — private payments on Stellar via stealth addresses (DKSAP)",
  "keywords": [
    "stellar",
    "stealth",
    "privacy",
    "dksap",
    "cli",
    "payments"
  ],
  "bin": {
    "shade": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "dev": "tsx src/index.ts",
    "cli": "tsx src/index.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "stellar-shade": "0.1.0",
    "@stellar/stellar-sdk": "^16.0.0",
    "@noble/hashes": "^1.6.1",
    "@noble/curves": "^1.7.0",
    "@scure/bip39": "^1.5.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@shade/crypto": "0.1.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stellarshade-labs/Shade.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/stellarshade-labs/Shade#readme",
  "bugs": {
    "url": "https://github.com/stellarshade-labs/Shade/issues"
  }
}
